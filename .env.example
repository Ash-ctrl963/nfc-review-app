# ---------------------------------------------------------------------------
# App / business config
# ---------------------------------------------------------------------------

# Public base URL of the deployed app. Must match exactly what's written to
# the NFC tag and encoded in the QR code.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Display name and logo shown on the review page.
NEXT_PUBLIC_BUSINESS_NAME="Your Business Name"
NEXT_PUBLIC_BUSINESS_LOGO_URL=/logo.svg

# Where the "Continue to Google Reviews" button sends the customer.
# Get this from your Google Business Profile ("Ask for reviews" link).
GOOGLE_REVIEW_URL=https://g.page/r/your-google-review-link/review

# ---------------------------------------------------------------------------
# AI (Google Gemini API) — required. Server-side only, never exposed to
# the client. Get a free key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------

GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-flash-latest

# ---------------------------------------------------------------------------
# Database (Supabase Postgres) — required. See README "Database setup".
# ---------------------------------------------------------------------------

# Either name works for the URL - if you already have NEXT_PUBLIC_SUPABASE_URL
# from a Supabase quickstart, you don't need to duplicate it under this name.
SUPABASE_URL=https://your-project.supabase.co

# The service_role secret key from Project Settings -> API. This is NOT the
# same as the publishable/anon key - this app relies on Row Level Security
# being enabled with zero policies, so only the service_role key can read
# or write the events table. There is no public-safe substitute for this one.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Internal testing/stats view protection
# ---------------------------------------------------------------------------

# Shared secret required as a query param to view /internal/stats.
# Generate any random string for this.
INTERNAL_STATS_SECRET=change-me-to-a-random-string
